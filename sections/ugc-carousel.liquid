{% schema %}
{
  "name": "UGC Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Real Adventurers Everywhere"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real customer photos"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "Real customers. Real gear. Real adventures."
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fafafa"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)",
          "info": "Leave empty for non-clickable image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text",
          "default": "Customer Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Carousel",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}

<div class="ugc-carousel-section-{{ section.id }}">
  
  {% if section.settings.heading != blank %}
  <!-- Main Heading -->
  <div class="ugc-heading">
    <h2>
      {{ section.settings.heading }}
    </h2>
  </div>
  {% endif %}
  
  {% if section.settings.subheading != blank %}
  <!-- Subheading -->
  <div class="ugc-subheading">
    <h3>
      {{ section.settings.subheading }}
    </h3>
  </div>
  {% endif %}
  
  {% if section.blocks.size > 0 %}
  <div class="ugc-auto-scroll">
    <div class="ugc-track">
      {% for block in section.blocks %}
        {% if block.settings.image %}
          <div class="ugc-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
                <img src="{{ block.settings.image | img_url: '520x520', crop: 'center' }}" alt="{{ block.settings.alt | escape }}" width="260" height="260">
              </a>
            {% else %}
              <img src="{{ block.settings.image | img_url: '520x520', crop: 'center' }}" alt="{{ block.settings.alt | escape }}" width="260" height="260">
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
      
      <!-- Duplicate for seamless scrolling -->
      {% for block in section.blocks %}
        {% if block.settings.image %}
          <div class="ugc-item">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
                <img src="{{ block.settings.image | img_url: '520x520', crop: 'center' }}" alt="{{ block.settings.alt | escape }}" width="260" height="260">
              </a>
            {% else %}
              <img src="{{ block.settings.image | img_url: '520x520', crop: 'center' }}" alt="{{ block.settings.alt | escape }}" width="260" height="260">
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
  
  {% if section.settings.footer_text != blank %}
  <p class="ugc-footer-text">
    {{ section.settings.footer_text }}
  </p>
  {% endif %}

  <style>
    .ugc-carousel-section-{{ section.id }} {
      position: relative;
      width: 100%;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-heading {
      text-align: center;
      padding: 0px 10px 10px;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-heading h2 {
      font-family: 'Oswald', sans-serif;
      font-size: 28px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-subheading {
      text-align: center;
      padding: 5px 10px 10px;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-subheading h3 {
      font-family: 'Oswald', sans-serif;
      font-size: 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0;
      font-weight: normal;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-auto-scroll {
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
      background: {{ section.settings.background_color }};
      overflow: hidden;
      padding: 0;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-track {
      display: flex;
      animation: ugc-scroll-{{ section.id }} {{ section.settings.scroll_speed }}s linear infinite;
      width: max-content;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-item {
      flex: 0 0 auto;
      width: 260px;
      height: 260px;
      margin-right: 4px;
      position: relative;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 6px;
      transition: transform 0.3s ease;
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-item:hover img {
      transform: scale(1.05);
    }
    
    .ugc-carousel-section-{{ section.id }} .ugc-footer-text {
      text-align: center;
      font-size: 12px;
      color: #999;
      margin-top: 5px;
    }
    
    @keyframes ugc-scroll-{{ section.id }} {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</div> 