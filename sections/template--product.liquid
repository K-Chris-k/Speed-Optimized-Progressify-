<div style="display:none" id="prorw_reviews_container_data" class="prorw-container  prorw-wide-container ">
  {% render 'proviews_widget' %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {

    setTimeout(function() {
      const quantityOptions = document.querySelectorAll('.quantity-option');
      if (quantityOptions.length === 0) return;
      quantityOptions[0].classList.add('selected');
      const allQuantityInputs = document.querySelectorAll('input[aria-label="quantity"], .js-qty__num, [id^="Quantity"], input[name="quantity"], input[name="quantity-js"]');
      let vueInstance = null;
      try {
        const vueApp = document.querySelector('wetheme-product-form');
        if (vueApp && vueApp.__vue__) {
          vueInstance = vueApp.__vue__;
          console.log('Vue实例已找到');
        }
      } catch(e) {
        console.log('查找Vue实例时出错:', e);
      }
      quantityOptions.forEach(option => {
        option.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          // 获取数量
          const qty = parseInt(this.getAttribute('data-quantity'));
          if (isNaN(qty)) return;
          
          console.log('选择了数量:', qty);
          
          // 更新选中状态
          quantityOptions.forEach(opt => opt.classList.remove('selected'));
          this.classList.add('selected');
          
          // 更新所有数量输入框
          allQuantityInputs.forEach(input => {
            // 更新值
            input.value = qty;
            
            // 触发各种事件
            try {
              // 原生事件
              input.dispatchEvent(new Event('change', { bubbles: true }));
              input.dispatchEvent(new Event('input', { bubbles: true }));
              
              // jQuery事件
              if (window.jQuery) {
                window.jQuery(input).trigger('change').trigger('input');
              }
            } catch(e) {
              console.log('触发事件时出错:', e);
            }
          });
          
          // 直接更新Vue实例
          if (vueInstance) {
            try {
              vueInstance.quantity = qty;
              if (typeof vueInstance.updateQuantity === 'function') {
                vueInstance.updateQuantity(qty);
              }
            } catch(e) {
              console.log('更新Vue实例时出错:', e);
            }
          }
          
          // 更新显示元素
          updateDisplayElements(qty);
          
          // 如果有表单，直接更新表单中的数量
          const form = document.getElementById('AddToCartForm');
          if (form) {
            const hiddenQty = form.querySelector('input[name="quantity"]');
            if (hiddenQty) {
              hiddenQty.value = qty;
            }
          }
          
          console.log('数量已更新为:', qty);
        });
      });
      
      // 更新显示元素
      function updateDisplayElements(qty) {
        // 查找底部数量选择器的数字显示元素
        const bottomQuantityDisplay = document.querySelector('.div-js-qty-bottom-qty-container .quantity-display, .bottom-quantity, .qty-count');
        if (bottomQuantityDisplay) {
          bottomQuantityDisplay.textContent = qty;
        }
        
        // 在特定范围内查找数量显示
        const qtyContainers = document.querySelectorAll('.div-js-qty-bottom-qty-container, .js-qty, [class*="qty-container"]');
        qtyContainers.forEach(container => {
          const qtyDisplay = container.querySelector('span:not([class]), .qty-number');
          if (qtyDisplay) {
            qtyDisplay.textContent = qty;
          }
        });
      }
      
      // 初始化：设置默认数量
      const defaultQty = parseInt(quantityOptions[0].getAttribute('data-quantity')) || 1;
      updateDisplayElements(defaultQty);
      
      // 确保所有输入框都有默认值
      allQuantityInputs.forEach(input => {
        input.value = defaultQty;
      });
      
      // 如果有Vue实例，也更新它
      if (vueInstance) {
        try {
          vueInstance.quantity = defaultQty;
        } catch(e) {
          console.log('初始化Vue实例时出错:', e);
        }
      }
      
      console.log('数量选择器初始化完成，默认数量:', defaultQty);
    }, 1000); // 延迟1秒执行
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Function to format money based on shop's currency format
    function formatMoney(cents, format) {
      if (typeof cents === 'string') {
        cents = cents.replace('.', '');
      }
      
      var value = '';
      var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      var formatString = format || '¥{{amount}}';

      function defaultTo(value, defaultValue) {
        return value == null || value !== value ? defaultValue : value;
      }

      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultTo(precision, 2);
        thousands = defaultTo(thousands, ',');
        decimal = defaultTo(decimal, '.');

        if (isNaN(number) || number == null) {
          return 0;
        }

        number = (number / 100.0).toFixed(precision);

        var parts = number.split('.');
        var dollarsAmount = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        var centsAmount = parts[1] ? (decimal + parts[1]) : '';

        return dollarsAmount + centsAmount;
      }

      switch (formatString.match(placeholderRegex)[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
        case 'amount_no_decimals_with_space_separator':
          value = formatWithDelimiters(cents, 0, ' ');
          break;
      }

      return formatString.replace(placeholderRegex, value);
    }

    // Get the current money format from the shop
    var moneyFormat = {{ shop.money_format | json }};
    
    // Get product JSON data
    var productJSON = null;
    try {
      var productJsonElement = document.getElementById('ProductJson-{{ section.id }}');
      if (productJsonElement) {
        productJSON = JSON.parse(productJsonElement.innerHTML);
      }
    } catch(e) {
      console.error('Error parsing product JSON:', e);
    }

    // Throttle function to prevent too many updates
    function throttle(func, limit) {
      let inThrottle;
      return function() {
        const args = arguments;
        const context = this;
        if (!inThrottle) {
          func.apply(context, args);
          inThrottle = true;
          setTimeout(() => inThrottle = false, limit);
        }
      };
    }

    // Function to update quantity discount prices based on current variant price
    function updateQuantityDiscountPrices(variantPrice) {
      if (!variantPrice) return;
      
      const options = document.querySelectorAll('.quantity-option');
      if (!options.length) return;
      
      options.forEach(option => {
        const quantity = parseInt(option.getAttribute('data-quantity'));
        const discountPercent = parseFloat(option.getAttribute('data-discount')) || 0;
        
        // Calculate prices
        const totalRegularPrice = variantPrice * quantity;
        let discountedPrice = totalRegularPrice;
        
        if (discountPercent > 0) {
          const discountAmount = totalRegularPrice * (discountPercent / 100);
          discountedPrice = totalRegularPrice - discountAmount;
        }
        
        const unitPrice = discountedPrice / quantity;
        
        // Update the price displays
        const finalPriceElement = option.querySelector('.final-price .money');
        const originalPriceElement = option.querySelector('.original-price .money');
        const unitPriceElement = option.querySelector('.unit-price-container .money');
        
        if (finalPriceElement) {
          finalPriceElement.innerHTML = formatMoney(discountedPrice, moneyFormat);
        }
        
        if (originalPriceElement) {
          originalPriceElement.innerHTML = formatMoney(totalRegularPrice, moneyFormat);
          // Only show original price if there's a discount
          const originalPriceContainer = option.querySelector('.original-price');
          if (originalPriceContainer) {
            originalPriceContainer.style.display = discountPercent > 0 ? 'block' : 'none';
          }
        }
        
        if (unitPriceElement) {
          unitPriceElement.innerHTML = formatMoney(unitPrice, moneyFormat);
        }
      });
    }
    
    // Throttled version of update function
    const throttledUpdate = throttle(updateQuantityDiscountPrices, 100);
    
    // Initialize with the current variant price
    let currentVariantPrice = {{ current_variant.price }};
    throttledUpdate(currentVariantPrice);
    
    // Get Vue instance
    let vueInstance = null;
    try {
      const vueApp = document.querySelector('wetheme-product-form');
      if (vueApp && vueApp.__vue__) {
        vueInstance = vueApp.__vue__;
        
        // Initial update with Vue's current variant price
        if (vueInstance.variant && vueInstance.variant.price) {
          currentVariantPrice = vueInstance.variant.price;
          throttledUpdate(currentVariantPrice);
        }
        
        // Watch for variant changes in the Vue instance
        if (vueInstance.$watch) {
          vueInstance.$watch('variant', function(newVariant) {
            if (newVariant && newVariant.price) {
              currentVariantPrice = newVariant.price;
              throttledUpdate(currentVariantPrice);
            }
          });
        }
      }
    } catch(e) {
      console.error('Error accessing Vue instance:', e);
    }
    
    // Listen for variant changes via custom events
    document.addEventListener('variant:changed', function(event) {
      if (event.detail && event.detail.variant && event.detail.variant.price) {
        currentVariantPrice = event.detail.variant.price;
        throttledUpdate(currentVariantPrice);
      }
    });
    
    // Additional event for other themes
    document.addEventListener('product:variant:change', function(event) {
      if (event.detail && event.detail.variant && event.detail.variant.price) {
        currentVariantPrice = event.detail.variant.price;
        throttledUpdate(currentVariantPrice);
      }
    });
    
    // Fallback for jQuery events
    if (window.jQuery) {
      jQuery(document).on('variant:changed variantChange product:variant:change', function(event, data) {
        if (data && data.variant && data.variant.price) {
          currentVariantPrice = data.variant.price;
          throttledUpdate(currentVariantPrice);
        }
      });
    }
    
    // Add direct click event listeners to variant selectors
    function setupVariantListeners() {
      // Common variant selector classes
      const variantSelectors = [
        '.variant-input label', 
        '.swatch-element label', 
        '.swatch label', 
        '[data-option-value]', 
        '.single-option-selector-item',
        '.product-form__input input[type="radio"]',
        '.product-form__swatch input[type="radio"]'
      ].join(',');
      
      document.querySelectorAll(variantSelectors).forEach(function(element) {
        element.addEventListener('click', function() {
          setTimeout(function() {
            // Try to get the current variant price from Vue instance
            if (vueInstance && vueInstance.variant && vueInstance.variant.price) {
              currentVariantPrice = vueInstance.variant.price;
              throttledUpdate(currentVariantPrice);
              return;
            }
            
            // Try to get the variant ID from the form
            const variantInput = document.querySelector('input[name="id"], select[name="id"]');
            if (variantInput && productJSON && productJSON.variants) {
              const variantId = parseInt(variantInput.value);
              const selectedVariant = productJSON.variants.find(v => v.id === variantId);
              if (selectedVariant && selectedVariant.price) {
                currentVariantPrice = selectedVariant.price;
                throttledUpdate(currentVariantPrice);
              }
            }
          }, 50);
        });
      });
      
      // Listen for change events on select elements
      document.querySelectorAll('select.single-option-selector, select[id^="ProductSelect-"]').forEach(function(select) {
        select.addEventListener('change', function() {
          setTimeout(function() {
            // Try to get the current variant price from Vue instance
            if (vueInstance && vueInstance.variant && vueInstance.variant.price) {
              currentVariantPrice = vueInstance.variant.price;
              throttledUpdate(currentVariantPrice);
            }
          }, 50);
        });
      });
    }
    
    // Setup variant listeners after a short delay
    setTimeout(setupVariantListeners, 500);
    
    // Handle quantity option selection
    const quantityOptions = document.querySelectorAll('.quantity-option');
    quantityOptions.forEach(option => {
      option.addEventListener('click', function() {
        // Update selected state
        quantityOptions.forEach(opt => opt.classList.remove('selected'));
        this.classList.add('selected');
        
        // Get quantity
        const qty = parseInt(this.getAttribute('data-quantity'));
        if (isNaN(qty)) return;
        
        // Update all quantity inputs
        const allQuantityInputs = document.querySelectorAll('input[aria-label="quantity"], .js-qty__num, [id^="Quantity"], input[name="quantity"], input[name="quantity-js"]');
        allQuantityInputs.forEach(input => {
          input.value = qty;
          
          // Trigger events
          try {
            input.dispatchEvent(new Event('change', { bubbles: true }));
            input.dispatchEvent(new Event('input', { bubbles: true }));
          } catch(e) {
            console.error('Error triggering input event:', e);
          }
        });
        
        // Update Vue instance if available
        if (vueInstance) {
          try {
            vueInstance.quantity = qty;
          } catch(e) {
            console.error('Error updating Vue quantity:', e);
          }
        }
      });
    });
    
    // Initialize with first option selected
    if (quantityOptions.length > 0) {
      quantityOptions[0].classList.add('selected');
    }
  });
</script>
