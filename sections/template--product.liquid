{{ 'plyr.min.css' | asset_url | stylesheet_tag }}
{{ 'shopify-model-viewer-ui.min.css' | asset_url | stylesheet_tag }}
<style>
  @media only screen and (max-width: 750px) {

            .product-medias__thumbnails-new {    display: block !important;   }
     .product-medias__thumbnail{
      margin-bottom:0px;
    }
  }

  .product-medias__thumbnail.product-single__media--selected ,.product-medias__thumbnail.swiper-slide-active{
    box-sizing: border-box;
    border: 1px solid #000000;
  }
  .product-medias__thumbnails-new {
      position: relative;
      margin-top: 30px;
  }
  .product-medias__thumbnail img{
    height:132px;
  }
  
    /* Quantity discount styling */
  .quantity-discount-container {
    margin: 20px 0;
    text-align: center;
    padding: 15px 0;
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
  }
  
  @media screen and (max-width: 767px) {
    .quantity-discount-container {
      margin: 15px 0;
      padding: 12px 5px;
    }
    .quantity-discount-title {
      font-size: 16px;
      margin-bottom: 15px;
    }
  }
  .quantity-discount-title {
    font-weight: bold;
    margin-bottom: 20px;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quantity-discount-title::after {
    content: "🛒";
    margin-left: 5px;
  }
  .quantity-discount-options {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    max-width: 900px;
    margin: 0 auto;
  }
  .quantity-option {
    flex: 1;
    border: 1px solid #e8e8e8;
    border-radius: 5px;
    padding: 20px 15px;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
  }
  .quantity-option.standard-price {
    background: #f0f0f0;
  }
  .quantity-option:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  .quantity-option.selected {
    border-color: #000;
    background: #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .rapi-bundles__bar-most-popular__content {
    background-color: var(--bar-most-popular-background-color);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: var(--bar-most-popular-color);
    /* font-family: inter, sans-serif; */
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    margin: 0 8px;
    padding: 6px 8px;
    word-break: break-all;
    background: #000;
    color: #fff;
}.rapi-bundles .rapi-bundles__bar-most-popular--above-title {
    left: -10px;
    position: relative;
    top: unset
}

.rapi-bundles .rapi-bundles__bar-most-popular--above-title .rapi-bundles__bar-most-popular__content,.rapi-bundles .rapi-bundles__bar-most-popular--above-title .rapi-bundles__bar-most-popular__content.square,.rapi-bundles .rapi-bundles__bar-most-popular--below-price .rapi-bundles__bar-most-popular__content,.rapi-bundles .rapi-bundles__bar-most-popular--below-price .rapi-bundles__bar-most-popular__content.square {
    border-radius: 0;
    margin: 0
}

.rapi-bundles .rapi-bundles__bar-most-popular--above-title .rapi-bundles__bar-most-popular__content.rounded,.rapi-bundles .rapi-bundles__bar-most-popular--below-price .rapi-bundles__bar-most-popular__content.rounded {
    border-radius: 8px;
    margin: 0
}

.rapi-bundles .rapi-bundles__bar-most-popular--above-title .rapi-bundles__bar-most-popular__content:after,.rapi-bundles .rapi-bundles__bar-most-popular--above-title .rapi-bundles__bar-most-popular__content:before,.rapi-bundles .rapi-bundles__bar-most-popular--below-price .rapi-bundles__bar-most-popular__content:after,.rapi-bundles .rapi-bundles__bar-most-popular--below-price .rapi-bundles__bar-most-popular__content:before {
    content: unset
}

.rapi-bundles__bar-container .rapi-bundles__bar-most-popular--pill~.rapi-bundles__bar-main,.rapi-bundles__bar-container .rapi-bundles__bar-most-popular--top-bar~.rapi-bundles__bar-main {
    margin-top: 8px
}

.rapi-bundles .rapi-bundles__bar-most-popular__content {
    background-color: var(--bar-most-popular-background-color);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: var(--bar-most-popular-color);
    font-family: inter,sans-serif;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    margin: 0 8px;
    padding: 6px 8px;
    word-break: break-all;
}


.rapi-bundles__bar-most-popular.heavy-bundle.rapi-bundles__bar-most-popular--top-bar {
    margin-bottom: -20px;
    position: relative;
    right: 1px;
    top: -30px;
}

.rapi-bundles .rapi-bundles__bar-most-popular__content:before {
    border-left: 8px solid transparent;
    border-left-color: transparent !important;
    left: 0;
    border-right: 8px solid transparent;
    border-right-color: transparent !important;
    right: 0;
    border-bottom-style: solid;
    border-bottom-width: 8px;
    content: "";
    display: block;
    filter: brightness(.7);
    height: 0;
    position: absolute;
    top: 0;
    width: 0;
    background: #000;
}

.rapi-bundles .rapi-bundles__bar-most-popular__content:after {
    border-right: 8px solid transparent;
    border-right-color: transparent !important;
    right: 0;
}

.rapi-bundles__bar-most-popular__content:before {
    border-bottom-style: solid;
    border-bottom-width: 8px;
    content: "";
    display: block;
    filter: brightness(.7);
    height: 0;
    position: absolute;
    top: 0;
    width: 0;
    border-bottom-color: #000 !important;
    /* border-right: 8px solid transparent; */
    /* border-right-color: transparent !important; */
    /* right: 0; */
}

.rapi-bundles__bar-most-popular__content:after {
    border-right: 8px solid transparent;
    border-right-color: transparent !important;
    right: 0;
    border-bottom-style: solid;
    border-bottom-width: 8px;
    content: "";
    display: block;
    filter: brightness(.7);
    height: 0;
    position: absolute;
    top: 0;
    width: 0;
    border-bottom-color: #000 !important;
}



.rapi-bundles__bar-most-popular__content:before {
    border-left: 8px solid transparent;
    border-left-color: transparent !important;
    left: 1px;
}

.rapi-bundles__bar-most-popular__content:after {
    border-right: 8px solid transparent;
    border-right-color: transparent !important;
    right: 0;
}
  
  @media screen and (max-width: 767px) {
    .rapi-bundles__bar-most-popular__content:after {

    right: -6px;
  }


  }
  .rapi-bundles__bar-most-popular__content:before {

    left: -7px;
}
.rapi-bundles__bar-most-popular__content{
  margin: 0 0px;
}

  .quantity-name {
    font-weight: bold;
    margin-bottom: 2px;
    font-size: 16px;
    color: #000;

  }
  .discount-label {
    color: #000;
    margin-bottom: 5px;
    font-weight: 600;
    font-size: 14px;
  }
  .standard-price-label {
    color: #000;
    margin-bottom: 5px;
    font-size: 14px;
  }
  .final-price {
    font-weight: bold;
    font-size: 16px;
  }
  .original-price {
    text-decoration: line-through;
    color: #999;
    font-size: 14px;
    margin-top: 3px;
  }
  
  @media screen and (max-width: 767px) {
    .original-price {
      font-size: 12px;
      margin-top: 2px;
    }
  }
  .unit-price-container {
    margin-top: 8px;
    font-size: 13px;
    color: #777;
  }

  .quantity-option.selected {
    border-color: #000;
    background: #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    background-color: rgb(217, 217, 217);
  }

  @media screen and (max-width: 767px) {
    .quantity-discount-options {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 10px;
    }
    .quantity-option {
      flex: 0 0 calc(33.33% - 10px);
      margin-bottom: 15px;
      padding: 15px 10px;
    }
    .quantity-name {
      font-size: 16px;
      margin-bottom: 4px;
    }
    .final-price {
      font-size: 16px;
    }
    .discount-label {
      font-size: 14px;
    }
    .unit-price-container {
      font-size: 12px;
    }
    .rapi-bundles__bar-most-popular.heavy-bundle.rapi-bundles__bar-most-popular--top-bar{
      margin-bottom: -20px;
    position: relative;
    right: 1px;
    top: -28px;
    }
  }
</style>
<div data-wetheme-section-type="template--product" data-wetheme-section-id="{{ section.id }}">
  {% assign pick_an_option = false %}

  {% if pick_an_option %}
    {%- assign current_variant = product.selected_variant -%}
  {% else %}
    {%- assign current_variant = product.selected_or_first_available_variant -%}
  {% endif %}

  {% assign on_sale = false %}
  {% if current_variant.compare_at_price > current_variant.price %}
    {% assign on_sale = true %}
  {% endif %}

  {%- assign product_description_width = '' -%}
  {%- assign product_image_width = '' -%}

  {% assign media_block = section.blocks | where: 'type', 'media' | first %}
  {% assign options_block = section.blocks | where: 'type', 'options' | first %}
  {% assign price_block = section.blocks | where: 'type', 'price' | first %}
  {% assign pickup_block = section.blocks | where: 'type', 'local_pickup' | first %}
  {% assign trust_block = section.blocks | where: 'type', 'trust_badges' | first %}
  {% assign giftwrap_block = section.blocks | where: 'type', 'giftwrap' | first %}
  {% assign buttons_block = section.blocks | where: 'type', 'buy_buttons' | first %}

  {% case media_block.settings.image_size %}
    {% when 'small' %}
      {%- assign product_description_width = 'large--seven-twelfths' -%}
      {%- assign product_image_width = 'large--five-twelfths' -%}
    {% when 'medium' %}
      {%- assign product_description_width = 'large--six-twelfths' -%}
      {%- assign product_image_width = 'large--six-twelfths' -%}
    {% when 'large' %}
      {%- assign product_description_width = 'large--five-twelfths' -%}
      {%- assign product_image_width = 'large--seven-twelfths' -%}
  {% endcase %}

  <div class="product-media-templates">
    {% assign featured_media = current_variant.featured_media | default: product.featured_media %}
    {% render 'product-media-templates',
      product: product,
      section_id: section.id,
      featured_media_id: featured_media.id,
      enable_image_zoom: media_block.settings.enable_image_zoom,
      enable_video_loop: media_block.settings.enable_video_loop
    %}
  </div>

  {% assign style = 'full_width' %}
  {% if media_block.settings['image-display'] == 'thumbnails' %}
    {% assign style = media_block.settings.thumbnail_position %}
  {% endif %}
  {% if product.media.size < 2 %}
    {% comment %} No thumbnails {% endcomment %}
    {% assign style = 'full_width' %}
  {% endif %}

  {% assign wrap_product_variant_id = 0 %}
  {% assign wrap_product = false %}
  {% if settings.giftwrap_product_selector != blank %}
    {% assign wrap_product = all_products[settings.giftwrap_product_selector] %}
    {% if wrap_product.variants.first.id %}
      {% assign wrap_product_variant_id = wrap_product.variants.first.id %}
    {% endif %}
  {% endif %}

  {% assign locations_enabled = false %}
  {% if pickup_block %}
    {% assign locations_enabled = true %}
  {% endif %}

  {% assign thumbnail_changes_variant = false %}
  {% if options_block.settings.thumbnail_changes_variant %}
    {% assign thumbnail_changes_variant = true %}
  {% endif %}

  <div class="wrapper-padded product-form-vue main-page-container">
    <wetheme-product-form
      inline-template
      v-bind:initial-variant-id="{{ current_variant.id }}"
      v-bind:product="product"
      v-bind:product-section="productSection"
      v-bind:theme="theme"
      v-bind:slides-per-view="slidesPerView"
      v-bind:is-featured-product="isFeaturedProduct"
      v-bind:section-id="'{{ section.id }}'"
      v-bind:thumbnail-changes-variant="{{ thumbnail_changes_variant }}"
      v-bind:has-thumbnails="{% if style != 'full_width' %}true{% else %}false{% endif %}"
      v-bind:image-zoom-enabled="{{ media_block.settings.enable_image_zoom }}"
      v-bind:video-loop-enabled="{{ media_block.settings.enable_video_loop }}"
      v-bind:cart-method="'{{ settings.ajax_cart_method }}'"
      v-bind:giftwrap-product-variant-id="{{ wrap_product_variant_id }}"
      v-bind:locations-enabled="{{ locations_enabled }}"
      language-url="{{ localization.language.root_url }}"
    >
      <div class="product-single-wrapper">
        <div
          class="grid product-single product-sticky-wrapper{% if options_block.settings.product_variant_style == 'dropdowns' %} variant-dropdown-enabled{% else %} variant-swatches-enabled{% endif %}"
          data-section-id="{{ section.id }}"
        >
          <div class="grid__item {{ product_image_width }} context mobile--no-top-margin">
            {% render 'product-media',
              product: product,
              style: style,
              enable_image_zoom: media_block.settings.enable_image_zoom,
              hide_soldout_variants: options_block.settings.hide_soldout_variants
            %}
          </div>

          <div class="grid__item {{ product_description_width }}{% if section.settings.enable_sticky %} product-sticky{% endif %}">
            <div>
              <div class="product-details-wrapper">
                <div class="product-details--form-wrapper{% if product.available %} product-details--form-wrapper---in-stock{% else %} product-details--form-wrapper---out-of-stock{% endif %}">
                  <div class="form-vertical">
                    {% form 'product', product, id: 'AddToCartForm' %}
                      {%- for block in section.blocks -%}
                        {%- case block.type -%}
                          {%- when '@app' -%}
                            <div id="shopify-block-{{block.id}}"></div>
                          {%- when 'cross-sells' -%}
                            <div id="cross-sell-{{block.id}}"></div>
                          {%- when 'sale_badge' -%}
                            <div
                              class="product-page--sale-badge{% unless current_variant.compare_at_price > current_variant.price %} js{% endunless %}"
                              v-if="isSale"
                              v-cloak
                            >
                              {{ 'products.product.on_sale' | t }}
                            </div>
                          {%- when 'vendor_sku' -%}
                            <div class="product__meta--sku-vendor">
                              <div
                                class="product__meta--sku {% if current_variant.sku == "" %}js{% endif %}"
                                v-if="variant && variant.sku !== ''"
                              >
                                <h4>
                                  {{ 'customer.order.sku' | t }}:
                                  <span class="js__currentVariantSKU" v-text="variant.sku">
                                    {{- current_variant.sku -}}
                                  </span>
                                </h4>
                              </div>
                              {% if product.vendor != '' %}
                                <div class="product__meta--vendor">
                                  <h4>{{ product.vendor | link_to_vendor }}</h4>
                                </div>
                              {% endif %}
                            </div>

                          {%- when 'title' -%}
                            <h1 itemprop="name" class="product-details-product-title" {{ block.shopify_attributes }}>
                              {{ product.title | escape }}
                            </h1>
                            {% render 'proviews_review_badge' with product as product %}
                          {%- when 'price' -%}
                            <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
                            <p
                              id="ComparePrice"
                              class="{% if settings.show_discount == 'hide' %}sale-price{% endif %}{% unless on_sale %} js{% endunless %} compare-price"
                              v-money="variant.compare_at_price"
                              data-original-compare-price="{{ current_variant.compare_at_price }}"
                            >
                              <span class="money">{{ current_variant.compare_at_price | money }}</span>
                            </p>

                            {% if on_sale %}
                              {% case settings.show_discount %}
                                {%- when 'percentage' -%}
                                  <li class="product-page--pricing--discount">
                                    <span
                                      class="variant-percentage-wrapper{% unless on_sale %} js{% endunless %}"
                                    >
                                      -<span
                                        class="variant-percentage"
                                        v-text="((variant.compare_at_price - variant.price) / variant.compare_at_price * 100).toFixed(0) + '%'"
                                      >
                                        {{
                                          current_variant.compare_at_price
                                          | minus: current_variant.price
                                          | times: 100.0
                                          | divided_by: current_variant.compare_at_price
                                          | money_without_currency
                                          | times: 100
                                          | remove: '.0'
                                        -}}
                                        %
                                      </span>
                                    </span>
                                  </li>
                                {%- when 'value' -%}
                                  <li class="product-page--pricing--discount">
                                    <span
                                      class="variant-value-wrapper{% unless on_sale %} js{% endunless %}"
                                    >
                                      -<span class="variant-value" v-money="variant.compare_at_price - variant.price">
                                        <span class="money">
                                          {{ current_variant.compare_at_price | minus: current_variant.price | money }}
                                        </span>
                                      </span>
                                    </span>
                                  </li>
                              {% endcase %}
                            {% endif %}

                            {% render 'product-pricing', current_variant: current_variant %}
                            {% render 'unit-price-measurement-variant', variant: current_variant %}

                            <script>
                              document.addEventListener('DOMContentLoaded', function() {
                                // 保存原始价格信息
                                window.originalProductPrice = {{ current_variant.price }};
                                window.originalComparePrice = {{ current_variant.compare_at_price }};
                                window.originalPriceRatio = {{ current_variant.compare_at_price | divided_by: current_variant.price | default: 1 }};
                                
                                // 保存原始价格差值
                                window.originalPriceDifference = {{ current_variant.compare_at_price | minus: current_variant.price | default: 0 }};
                              });
                            </script>

                            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                              <div class="product-page__policies rte">
                                {%- if cart.taxes_included and price_block.settings.tax_included -%}
                                  {{ 'products.product.include_taxes' | t }}
                                {%- endif -%}
                                {%- if shop.shipping_policy.body != blank and price_block.settings.shipping_policy -%}
                                  {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                                {%- endif -%}
                              </div>
                            {%- endif -%}

                            <div class="shopify-payment-terms__container">
                              {{ form | payment_terms }}
                            </div>

                          {%- when 'options' -%}
                            {% render 'product-options',
                              product: product,
                              variant_style: options_block.settings.product_variant_style,
                              section_id: section.id,
                              current_variant: current_variant,
                              hide_soldout_variants: options_block.settings.hide_soldout_variants
                            %}

                          {%- when 'giftwrap' -%}
                            {% if settings.giftwrap_product_selector > '' and product.available and wrap_product %}
                              {% if wrap_product.available %}
                                <div class="product__meta--giftwrap">
                                  <input type="checkbox" id="checkbox" v-model="giftwrapProduct" class="focus-visible">
                                  <label for="checkbox">{{ settings.giftwrap_label_text }}</label>
                                </div>
                              {% endif %}
                            {% endif %}

                          {%- when 'quantity' -%}
                            <div class="selector-wrapper{% if section.settings.image_size == 'large' %}col-md-12{% else %}col-md-6{% endif %} col-sm-12 col-xs-12">
                              <label for="Quantity" class="quantity-selector product-sub-label">
                                {{- 'products.product.quantity' | t -}}
                              </label>

                              <div class="js-qty">
                                <button
                                  type="button"
                                  aria-label="-"
                                  class="js-qty__adjust js-qty__adjust--minus icon-fallback-text"
                                  v-on:click="decreaseQuantity"
                                >
                                  <i class="fa fa-minus" aria-hidden="true"></i>
                                  <span class="fallback-text">−</span>
                                </button>
                                <input
                                  v-model="quantity"
                                  type="text"
                                  class="js-qty__num"
                                  value="1"
                                  min="1"
                                  aria-label="quantity"
                                  pattern="[0-9]*"
                                  name="quantity-js"
                                  id="Quantity"
                                >
                                <button
                                  type="button"
                                  aria-label="+"
                                  class="js-qty__adjust js-qty__adjust--plus icon-fallback-text"
                                  v-on:click="increaseQuantity"
                                >
                                  <i class="fa fa-plus" aria-hidden="true"></i>
                                  <span class="fallback-text">+</span>
                                </button>
                              </div>

                              <noscript>
                                <input
                                  class="quantity-noscript"
                                  type="number"
                                  name="quantity"
                                  id="Quantity-{{ section.id }}"
                                  aria-label="quantity"
                                  min="1"
                                  value="1"
                                >
                              </noscript>
                            </div>

                       


                            {%- when 'buy_buttons' -%}
                            <div class="paymentButtonsWrapper">
                              <div id="addtocart"></div>
                              <button
                                type="submit"
                                aria-label="{{ 'products.product.add_to_cart' | t }}"
                                v-cloak
                                name="add"
                                id="AddToCart"
                                class="btn{% if buttons_block.settings.show_smart_checkout and product.selling_plan_groups.size == 0 %} add-to-cart--secondary{% endif %}"
                                v-bind:class="{ disabled: addToCartDisabled }"
                                v-bind:disabled="addToCartDisabled"
                              >
                                <i
                                  class="fa fa-circle-o-notch fa-spin fa-2x fa-fw js"
                                  v-if="state === 'adding'"
                                  v-cloak
                                ></i
                                ><span class="sr-only">{{ 'collections.paginate.loading' | t }}</span>
                                <span
                                  class="{% if current_variant.available %}js{% endif %}"
                                  v-if="state === 'ready'"
                                  v-cloak
                                >
                                  {{- 'products.product.add_to_cart' | t -}}
                                </span>
                                <span class="js" v-if="state === 'added'" v-cloak>
                                  {{- 'products.product.added' | t -}}
                                </span>
                                <span
                                  class="{% unless current_variant.available %}js{% endunless %}"
                                  v-if="state === 'soldOut'"
                                  v-cloak
                                >
                                  {{- 'products.product.sold_out' | t -}}
                                </span>
                                <span class="js" v-if="state === 'unavailable'" v-cloak>
                                  {{- 'products.product.unavailable' | t -}}
                                </span>
                              </button>

                              <noscript>
                                <button type="submit" class="btn" aria-label="{{ 'products.product.add_to_cart' | t }}">
                                  <span>{{ 'products.product.add_to_cart' | t }}</span>
                                </button>
                              </noscript>

                              {% if buttons_block.settings.show_smart_checkout %}
                                {{ form | payment_button }}
                              {% endif %}
                            </div>

                          {%- when 'local_pickup' -%}
                            <div class="product-page--local-pickup" v-if="hasLocalPickup" v-html="hasLocalPickup"></div>

                          {%- when 'trust_badges' -%}
                            <div class="quantity-discount-container" {{ block.shopify_attributes }} id="quantity-discount-container">
                              <div class="quantity-discount-title">{{ block.settings.discount_title }}</div>
                              <div class="quantity-discount-options">
                                {% comment %} Option 1 (One) {% endcomment %}
                                {% assign option_name = 'option_1' %}
                                {% assign qty_field = option_name | append: '_qty' %}
                                {% assign discount_field = option_name | append: '_discount' %}
                                {% assign name_field = option_name | append: '_name' %}
                                
                                {% if block.settings[qty_field] > 0 %}
                                  {% assign quantity = block.settings[qty_field] %}
                                  {% assign discount_percent = block.settings[discount_field] | default: 0 %}
                                  
                                  <div class="quantity-option standard-price" 
                                       data-quantity="{{ quantity }}" 
                                       data-discount="{{ discount_percent }}"
                                       data-option="1">
                                    
                                    <div class="quantity-name">{{ block.settings[name_field] }}</div>
                                    <div class="standard-price-label">Standard Price</div>
                                    
                                    <div class="final-price">
                                      <span class="money"></span>
                                    </div>
                                    
                                    <div class="original-price">
                                      <span class="money"></span>
                                    </div>
                                    
                                    <div class="unit-price-container">
                                      <small><span class="money"></span> each</small>
                                    </div>
                                  </div>
                                {% endif %}
                                
                                {% comment %} Option 2 (Two) {% endcomment %}
                                {% assign option_name = 'option_2' %}
                                {% assign qty_field = option_name | append: '_qty' %}
                                {% assign discount_field = option_name | append: '_discount' %}
                                {% assign name_field = option_name | append: '_name' %}
                                
                                {% if block.settings[qty_field] > 0 %}
                                  {% assign quantity = block.settings[qty_field] %}
                                  {% assign discount_percent = block.settings[discount_field] | default: 0 %}
                                  
                                  <div class="quantity-option" 
                                       data-quantity="{{ quantity }}" 
                                       data-discount="{{ discount_percent }}"
                                       data-option="2">
                                    
                                    <div class="quantity-name">{{ block.settings[name_field] }}</div>
                                    
                                    {% if discount_percent > 0 %}
                                      <div class="discount-label">{{ discount_percent }}% OFF</div>
                                    {% endif %}
                                    
                                    <div class="final-price">
                                      <span class="money"></span>
                                    </div>
                                    
                                    <div class="original-price">
                                      {% if discount_percent > 0 %}
                                        <span class="money"></span>
                                      {% endif %}
                                    </div>
                                    
                                    <div class="unit-price-container">
                                      <small><span class="money"></span> each</small>
                                    </div>
                                  </div>
                                {% endif %}
                                
                                {% comment %} Option 4 (Four) {% endcomment %}
                                {% assign option_name = 'option_4' %}
                                {% assign qty_field = option_name | append: '_qty' %}
                                {% assign discount_field = option_name | append: '_discount' %}
                                {% assign name_field = option_name | append: '_name' %}
                                
                                {% if block.settings[qty_field] > 0 %}
                                  {% assign quantity = block.settings[qty_field] %}
                                  {% assign discount_percent = block.settings[discount_field] | default: 0 %}
                                  
                                  <div class="quantity-option{% if block.settings.show_best_value %} best-value{% endif %}" 
                                       data-quantity="{{ quantity }}" 
                                       data-discount="{{ discount_percent }}"
                                       data-option="4">
                                    
                                    {% if block.settings.show_best_value %}
                                      <div class="rapi-bundles__bar-most-popular heavy-bundle rapi-bundles__bar-most-popular--top-bar">
                                        <div class="rapi-bundles__bar-most-popular__content">
                                          {{ block.settings.best_value_text }}
                                        </div>
                                      </div>
                                    {% endif %}
                                    
                                    <div class="quantity-name">{{ block.settings[name_field] }}</div>
                                    
                                    {% if discount_percent > 0 %}
                                      <div class="discount-label">{{ discount_percent }}% OFF</div>
                                    {% endif %}
                                    
                                    <div class="final-price">
                                      <span class="money"></span>
                                    </div>
                                    
                                    <div class="original-price">
                                      {% if discount_percent > 0 %}
                                        <span class="money"></span>
                                      {% endif %}
                                    </div>
                                    
                                    <div class="unit-price-container">
                                      <small><span class="money"></span> each</small>
                                    </div>
                                  </div>
                                {% endif %}
                              </div>
                            </div>

                          {%- when 'product_meta' -%}
                            <div class="product__meta">
                              {% if product.tags.size > 0 %}
                                <div class="product__meta--tags">
                                  <span
                                    ><strong>{{ 'products.product.tags' | t }}:</strong>
                                  </span>
                                  {% for tag in product.tags %}
                                    <a href="{{ routes.all_products_collection_url }}/{{ tag | handleize }}"
                                      ><span>{{ tag }}</span></a
                                    >
                                    {%- if forloop.last == false %}, {% endif %}
                                  {% endfor %}
                                </div>
                              {% endif %}

                              {% if product.collections.size > 0 %}
                                <div class="product__meta--tags">
                                  <span
                                    ><strong>{{ 'products.product.category' | t }}:</strong>
                                  </span>
                                  {% for collection in product.collections %}
                                    <a href="{{ collection.url }}"
                                      ><span>{{ collection.title }}</span></a
                                    >
                                    {%- if forloop.last == false %}, {% endif %}
                                  {% endfor %}
                                </div>
                              {% endif %}

                              {% if product.type != '' %}
                                <div class="product__meta--type">
                                  <span
                                    ><strong>{{ 'products.product.type' | t }}: </strong></span
                                  >
                                  <span>{{ product.type }}</span>
                                </div>
                              {% endif %}
                            </div>

                          {%- when 'social_sharing' -%}
                            {% render 'social-share' %}

                          {% when 'custom_liquid' %}
                            {{ block.settings.custom_liquid }}

                          {% when 'product-rating' %}
                            {% if block.settings.rating != blank %}
                              {% if block.settings['rating-label'] != blank %}
                                <p class="rating-label">{{ block.settings['rating-label'] }}</p>
                                {% assign rating_aria_label = block.settings['rating-label'] %}
                              {% else %}
                                {% assign rating_aria_label = 'Rating' %}
                              {% endif %}

                              {% if block.settings['rating-icon-full'] %}
                                {% liquid
                                  assign rating_decimal = 0
                                  assign decimal = block.settings.rating | modulo: 1
                                  if decimal >= 0.3 and decimal <= 0.7
                                    assign rating_decimal = 0.5
                                  elsif decimal > 0.7
                                    assign rating_decimal = 1
                                  endif

                                  assign full_icons = block.settings.rating | floor | plus: rating_decimal | floor
                                  assign empty_icons = block.settings['rating-max'] | round | minus: full_icons
                                  if rating_decimal == 0.5
                                    assign empty_icons = empty_icons | minus: 1
                                  endif

                                  assign full_alt = block.settings['rating-icon-full'].alt | default: 'Full icon'
                                  assign empty_alt = block.setting['rating-icon-empty'].alt | default: 'Empty icon'
                                %}

                                <div
                                  class="rating-icons"
                                  role="img"
                                  aria-label="{{ rating_aria_label }} - {{ block.settings.rating }} out of {{ block.settings.rating-max }}"
                                >
                                  {% for i in (1..full_icons) %}
                                    <div class="rating-icons__icon" aria-hidden="true">
                                      {% render 'responsive-image' with block.settings['rating-icon-full'],
                                        alt: full_alt
                                      %}
                                    </div>
                                  {% endfor %}

                                  {% if block.settings['rating-icon-empty'] %}
                                    {% if rating_decimal == 0.5 %}
                                      <div class="rating-icons__icon rating-icons__icon--half" aria-hidden="true">
                                        <div class="rating-icons__image--full">
                                          {% render 'responsive-image' with block.settings['rating-icon-full'],
                                            alt: full_alt
                                          %}
                                        </div>
                                        <div class="rating-icons__image--empty">
                                          {% render 'responsive-image' with block.settings['rating-icon-empty'],
                                            alt: empty_alt
                                          %}
                                        </div>
                                      </div>
                                    {% endif %}

                                    {% for i in (1..empty_icons) %}
                                      <div class="rating-icons__icon" aria-hidden="true">
                                        {% render 'responsive-image' with block.settings['rating-icon-empty'],
                                          alt: empty_alt
                                        %}
                                      </div>
                                    {% endfor %}
                                  {% endif %}
                                </div>
                              {% else %}
                                <p>{{ block.settings.rating }} / {{ block.settings['rating-max'] }}</p>
                              {% endif %}
                            {% endif %}

                          {% when 'image-offer' %}
                            <div class="image-offer-container">
                              {% if block.settings.link != blank and block.settings.image != blank %}
                                <a href="{{ block.settings.link }}" class="image-offer-container--is-link">
                              {% endif %}

                              {% if block.settings.image == blank %}
                                {{ 'lifestyle-1' | placeholder_svg_tag: 'icon--placeholder' }}
                              {% else %}
                                {% capture alt %}{{ block.settings.image.alt | default: shop.name }}{% endcapture %}
                                {% render 'responsive-image' with block.settings.image, alt: alt %}
                              {% endif %}

                              {% if block.settings.link != blank and block.settings.image != blank %}
                                </a>
                              {% endif %}
                            </div>


                            
                            





                          {% when 'text-with-icon' %}
                            {% render 'text-with-icon',
                              icon: block.settings.icon,
                              text: block.settings.text,
                              link: block.settings.link
                            %}




                        {%- endcase -%}
                      {%- endfor -%}

                      <div class="errors qty-error" v-if="hasErrors" v-html="hasErrors" v-cloak></div>
                    {% endform %}

                    {% if section.settings.show_out_of_stock_email %}
                      {% render 'out-of-stock-form' %}
                      <div class="shopify-disclaimer--hidden">
                        {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </wetheme-product-form>
  </div>

  {% unless product == empty %}
    <script type="application/json" class="product-json" id="ProductJson-{{ section.id }}">
      {{ product | json }}
    </script>
  {% endunless %}
</div>

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when '@app' -%}
      <div id="appInit" data-block-id="{{block.id}}">
        {% render block %}
      </div>
    {%- when 'image-offer' -%}
      <style>
        .image-offer-container--is-link:hover img {
          border-color: {{ block.settings.hover_border_color }};
        }
      </style>
    {% when 'cross-sells' %}
      <div class="cross-sell-block" id="cross-sell-{{block.id}}">
        {% render 'cross-sells' with block_settings: block.settings %}
      </div>
    

      

      
      <style>
        .quantity-option.selected {
          border-color: #000;
          background: #fff;
          box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
      </style>
  {% endcase %}
{% endfor %}

