{% comment %}
  Renders text/color swatches for a product option.
  Set the extension of your color files below. Use 'png', 'jpeg', 'jpg' or 'gif'.

  Accepts:
    - swatch_option: The product option to render as a swatch.
    - option_index: The index of the option.
    - swatch_section_id: The section id. (required)
    - size_option_name: The name of the size option.
    - size_guide_page: The size guide page object.
    - size_guide_label: The label for the size guide link.
    - hide_out_of_stock_variants: Boolean to hide out of stock variants.

  Usage:
    {% render 'swatch' with swatch_option: option, option_index: option_idx, product: product, size_option_name: size_option_name, size_guide_page: size_guide_page, size_guide_label: size_guide_label, hide_out_of_stock_variants: hide_out_of_stock_variants %}

  Color Mapping:
    - This snippet includes automatic color name to HEX conversion (line ~30)
    - To add custom colors: Edit the 'color_map' variable below
    - Format: 'colorname:#HEXCODE' (e.g., 'ocean blue:#4F42B5')
    - Unmapped colors will fallback to CSS standard color names
    - Priority: Metafield color > Color map > CSS standard colors
{% endcomment %}

<safe-load-scripts class="hidden">
  <script src="{{ 'component-product-swatch.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="product-swatch"></script>
</safe-load-scripts>

{% liquid 
  assign file_extension = 'png' 
  assign color_langs = 'color,colour,couleur,colore,farbe,색,色,färg,farve' | split: ','
  assign swatch_image_options = settings.show_variant_image_for_options | split: ','
  
  comment
    Color name to RGB/HEX mapping - Extended color names
    Format: colorname:#HEXCODE
    Add your custom colors here to ensure accurate color display
  endcomment
  assign color_map = 'white:#FFFFFF,black:#000000,red:#FF0000,darkred:#8B0000,green:#00FF00,darkgreen:#006400,lightgreen:#90EE90,light green:#90EE90,blue:#0000FF,darkblue:#00008B,lightblue:#ADD8E6,yellow:#FFFF00,orange:#FFA500,darkorange:#FF8C00,purple:#800080,darkpurple:#301934,pink:#FFC0CB,hotpink:#FF69B4,brown:#A52A2A,gray:#808080,grey:#808080,darkgray:#A9A9A9,darkgrey:#A9A9A9,lightgray:#D3D3D3,lightgrey:#D3D3D3,silver:#C0C0C0,classicsilver:#BCC6CC,classic silver:#BCC6CC,gold:#FFD700,beige:#F5F5DC,navy:#000080,teal:#008080,cyan:#00FFFF,magenta:#FF00FF,lime:#00FF00,maroon:#800000,olive:#808000,aqua:#00FFFF,indigo:#4B0082,violet:#EE82EE,coral:#FF7F50,salmon:#FA8072,khaki:#F0E68C,lavender:#E6E6FA,peach:#FFDAB9,mint:#98FF98,mintgreen:#98FF98,ivory:#FFFFF0,cream:#FFFDD0,tan:#D2B48C,burgundy:#800020,charcoal:#36454F,slate:#708090,oceanblue:#4F42B5,ocean blue:#4F42B5,boldpurple:#9B30FF,bold purple:#9B30FF,sky:#87CEEB,skyblue:#87CEEB,rose:#FF007F,emerald:#50C878,ruby:#E0115F,sapphire:#0F52BA,turquoise:#40E0D0,amber:#FFBF00,bronze:#CD7F32,copper:#B87333,crimson:#DC143C,fuchsia:#FF00FF,jade:#00A86B,lemon:#FFF700,lilac:#C8A2C8,mustard:#FFDB58,orchid:#DA70D6,plum:#DDA0DD,scarlet:#FF2400,seagreen:#2E8B57,sienna:#A0522D,wheat:#F5DEB3' | split: ','


  comment
    Check if the swatch is a category metafield swatch 
  endcomment
  for value in swatch_option.values
    assign is_category_swatch = false
    if value.swatch.image != blank
      assign is_category_swatch = true
    elsif value.swatch.color != blank
      assign is_category_swatch = true
    endif
  endfor

  comment
    Check if the swatch should reflect the variant image
  endcomment
  assign option_name_formatted = swatch_option.name | camelize
  for image_option in swatch_image_options
    assign show_variant_image = false
    assign image_option_formatted = image_option | camelize
    if image_option_formatted == option_name_formatted
      assign show_variant_image = true
    endif
    if show_variant_image
      break
    endif
  endfor

  comment
    Check if the swatch is a regular color swatch 
  endcomment
  assign is_color_swatch = false
  assign downcased_option = swatch_option.name | camelize | downcase
  if color_langs contains downcased_option
    assign is_color_swatch = true
  endif
%}

{% if swatch_option == blank %}
  <div class="swatch error">
    <p>You must include the snippet swatch.liquid with the product option.</p>
    <p>Use: <code>{% raw %}{% render 'swatch' with swatch_option: 'product option here' %}{% endraw %}</code></p>
    <p>Example: <code>{% raw %}{% render 'swatch' with swatch_option: option %}{% endraw %}</code></p>
  </div>
{% else %}
  <product-swatch 
    data-swatch-sold-out-string="{{ 'products.product.sold_out' | t }}"  
    class="swatch{% if is_color_swatch or is_category_swatch or show_variant_image %} is-color-swatch{% endif %}" 
    data-option-index="{{ option_index }}"
    data-section-id="{{ swatch_section_id }}"
    data-product-id="{{ product.id }}"
  >
    {% comment %} ============ OPTION LABEL ============ {% endcomment %}
    <div class="option-label-wrapper{% if is_color_swatch or is_category_swatch or show_variant_image %} is-color-label{% endif %}">
      <div>
        <div class="header label-font">{{ swatch_option.name }}</div>
        {% if is_color_swatch or is_category_swatch or show_variant_image %}
          <div class="header product-swatch-color-name" data-color-swatch-name-container>
            <span data-color-swatch-name>{{ swatch_option.selected_value | truncate: 22 }}</span>
            <span data-color-swatch-state></span>
          </div>
        {% endif %}
      </div>
      {% assign formatted_swatch_option_name = swatch_option.name | downcase %}
      {% assign formatted_size_option_name = size_option_name | downcase %}
      {%- if formatted_swatch_option_name == formatted_size_option_name and size_guide_page != blank -%}
        <safe-load-scripts class="hidden">
          <script src="{{ 'component-size-guide-link.js' | asset_url }}" defer="defer" type="module" data-flow-load-key="size-guide-link"></script>
        </safe-load-scripts>

        <size-guide-link id="size-guide" class="text-link-animated">
          <a data-size-guide-link id="size-guide-link" tabindex="0" href="{{ size_guide_page.url }}">{{ size_guide_label | default: size_guide_page.title }}</a>
        </size-guide-link>
      {%- endif -%}
    </div>

    {% comment %} ============ OPTION VARIANTS (SWATCHES) ============ {% endcomment %}
    <div class="swatch-items-wrapper">
      {% for value in swatch_option.values %}
        {% liquid
          if hide_out_of_stock_variants and value.available == false
            assign show_variant = false
          else 
            assign show_variant = true
          endif

          assign is_combined_listing = false
          if value.product_url != blank
            assign is_combined_listing = true
            assign show_variant = true
            assign item_fetch_url = value.product_url | append: '?variant=' | append: value.variant.id
            assign product_url = value.product_url
          else
            assign item_fetch_url = value.variant.url
            assign product_url = value.variant.product.url
          endif
        %}

        {%- capture input_id -%}
          {{ swatch_section_id }}-{{ option_index }}-{{ forloop.index0 -}}
        {%- endcapture -%}

        {% if show_variant %}
          <div 
            data-swatch-option-available="{{ value.available }}"
            data-swatch-variant-id="{{ value.variant.id }}"
            data-selected-swatch-variant-id="{{ swatch_option.selected_value.variant.id }}"
            data-option="{{ swatch_option.name }}"
            data-option-index="{{ option_index }}"
            data-value="{{ value | escape | truncate: 22 }}" 
            data-media-id="{{ value.variant.featured_media.id }}" 
            class="swatch-element variant-swatch {% if is_color_swatch or is_category_swatch or show_variant_image %}color {% endif %}{{ value | handle }} {% if value.available %}available{% else %}soldout{% endif %}{% if swatch_option.selected_value == value %} active{% endif %}"
          >

            <input
              data-product-variant
              data-option-value-id="{{ value.id }}"
              data-is-combined-listing="{{ is_combined_listing }}"
              data-product-fetch-url="{{ item_fetch_url }}"
              data-product-url="{{ product_url }}"
              id="{{ input_id }}"
              class="visually-hidden"
              type="radio"
              name="option-{{ option_index | plus: 1 }}-{{ swatch_section_id }}"
              value="{{ value | escape }}"
              {% if swatch_option.selected_value == value %} checked{% endif %}
            />

            {% if is_color_swatch or is_category_swatch or show_variant_image %}
              {% liquid 
                comment 
                  Define the color value - preserve original for CSS fallback
                endcomment
                assign bg_color = value | downcase
                
                comment 
                  If value already contains HEX code, use it directly
                endcomment
                if value contains '#'
                  assign bg_color = value | downcase
                else
                  comment 
                    Convert color name to HEX if it matches our color map
                    This handles both standard colors and custom colors
                  endcomment
                  assign normalized_value = value | downcase | strip | replace: ' ', ''
                  assign found_color = false
                  
                  for color_pair in color_map
                    assign color_parts = color_pair | split: ':'
                    assign color_name = color_parts[0] | strip | replace: ' ', ''
                    assign color_code = color_parts[1] | strip
                    
                    if normalized_value == color_name
                      assign bg_color = color_code
                      assign found_color = true
                      break
                    endif
                  endfor
                  
                  comment
                    If not found in map, keep original value (CSS standard colors will still work)
                  endcomment
                  unless found_color
                    assign bg_color = value | downcase
                  endunless
                endif

                comment 
                  Metafield color has highest priority - override if exists
                endcomment
                if value.swatch.color
                  assign bg_color = value.swatch.color
                endif

                comment 
                  Define the image url 
                endcomment
                assign bg_img_url = value | handle | append: '.' | append: file_extension | file_url
                unless show_variant_image
                  comment 
                  Check if the swatch has a category metafield image 
                  endcomment
                  if value.swatch.image
                    assign bg_img_url = value.swatch.image | image_url: width: 50
                  endif
                else
                  comment 
                  Check if the variant has a featured media 
                  endcomment
                  if value.variant.featured_image
                    assign bg_img_url = value.variant.featured_image | image_url: width: 50
                  endif
                endunless
              %}

              <label
                for="{{ input_id }}" 
                style="{% if bg_img_url contains 'v=' %}background-image: url({{ bg_img_url }}); background-size: cover; background-position: center center;{% else %} background-color: {{ bg_color }};{% endif %}"
                aria-labelledby="{{ input_id }}"
              >
                <span class="sr-only">{{ value }}</span>
                <span class="product-swatch-sold-out product-swatch-sold-out-background"></span>
                <span class="product-swatch-sold-out product-swatch-sold-out-foreground"></span>
              </label>
            {% else %}
              <label for="{{ input_id }}" aria-labelledby="{{ input_id }}">
                {{ value }}
              </label>
            {% endif %}
          </div>
        {% endif %}
        {% comment %} ============ VARIANT JSON ============ {% endcomment %}
        <script type="application/json" data-resource="{{ input_id }}">
          {{ value.variant | json }}
        </script>
      {% endfor %}
    </div>
    {% if product %}
      <div class="bottom-purchase-info">
        <div class="bottom-purchase-info__container">
          <div class="bottom-purchase-info__image">
            <img src="{{ product.selected_or_first_available_variant.featured_media | default: product.featured_media | image_url: width: 120 }}"
              alt="{{ product.title | escape }}" class="js-bottom-variant-image" data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              width="70" height="70">
          </div>
          <div class="bottom-purchase-info__content">
            <h3 class="bottom-purchase-info__title">{{ product.title | escape }}</h3>
            <div class="bottom-purchase-info__review-badge">
              {% render 'reviews-star-rating' with
              rating_product: product,
              star_color: settings.star_rating_color,
              classes: alignment_class,
              star_size: settings.star_size,
              no_reviews_label: settings.no_reviews_label,
              show_rating_as: settings.show_rating_as,
              show_product_rating_if_no_reviews: settings.show_product_rating_if_no_reviews,
              color_scheme: section_color_scheme,
              wrapper_class: 'product-grid--rating'
            %}
            </div>
            <span class="visually-hidden bottom-purchase-info__compare-price js-bottom-compare-price">
              Regular price
            </span>
            <span id="BottomProductPrice" class="bottom-purchase-info__price" itemprop="price" content="{{ product.selected_or_first_available_variant.price | divided_by: 100 }}"
              v-bind:content="variant ? variant.price / 100 : null"
              v-html="variant ? money(variant.price) : 'Unavailable'"
              data-unavailable-text="Unavailable">
              <span class="money">{{ product.selected_or_first_available_variant.price | money }}</span>
            </span>
          </div>
          <div class="bottom-purchase-info__dropdown-wrapper-new-style">
            
            {% comment %} 只有在有多个变体时才显示变体选择器 {% endcomment %}
            {% if product.options.size > 0 and product.variants.size > 1 %}
              {% for option in product.options_with_values %}
              {% assign option_index = forloop.index0 %}
              
              <div class="bottom-purchase-dropdown">
                <div class="bottom-purchase-dropdown__header">{{ option.name }}</div>
                
                {% comment %} 使用真正的select元素 {% endcomment %}
                <select 
                  class="bottom-purchase-select" 
                  name="bottom-option-{{ option_index | plus: 1 }}" 
                  data-option-index="{{ option_index }}"
                  data-option-name="{{ option.name }}"
                >
                  {% for value in option.values %}
                    <option 
                      value="{{ value | escape }}"
                      data-option-index="{{ option_index }}"
                      data-variant-id="{{ value.variant.id }}"
                      {% if option.selected_value == value %}selected{% endif %}
                      {% unless value.available %}disabled{% endunless %}
                    >
                      {{ value }}{% unless value.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
                    </option>
                  {% endfor %}
                </select>
              </div>
              {% endfor %}
            {% endif %}
      
            <div class="bottom-purchase-dropdown__quantity-wrapper">
              <div class="js-qty bottom-qty-container">
                <button
                  type="button"
                  aria-label="-"
                  class="js-qty__adjust js-qty__adjust--minus icon-fallback-text bottom-qty-button"
                  data-action="decrease"
                  data-quantity-button="decrease"
                >
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="flex-full" aria-hidden="true"><path d="M5 10H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  <span class="fallback-text">−</span>
                </button>
                <input
                  type="number"
                  class="js-qty__num"
                  value="1"
                  min="1"
                  aria-label="quantity"
                  pattern="[0-9]*"
                  name="quantity-bottom"
                  id="BottomQuantity"
                  data-quantity-input="bottom"
                  data-main-quantity-selector="[name='quantity']:not(#BottomQuantity)"
                >
                <button
                  type="button"
                  aria-label="+"
                  class="js-qty__adjust js-qty__adjust--plus icon-fallback-text bottom-qty-button"
                  data-action="increase"
                  data-quantity-button="increase"
                >
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="flex-full" aria-hidden="true"><path d="M5 10H10M10 10H15M10 10V5M10 10V15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  <span class="fallback-text">+</span>
                </button>
              </div>
            </div>
            
            <div class="bottom-purchase-info__btn-container">
              <div class="paymentButtonsWrapper btn-wrapper-default">
                {% comment %} <div id="addtocart"></div> {% endcomment %}
                <button
                  type="submit"
                  aria-label="{{ 'products.product.add_to_cart' | t }}"
                  name="add"
                  id="AddToCart"
                  class="btn{% if buttons_block.settings.show_smart_checkout and product.selling_plan_groups.size == 0 %} add-to-cart--secondary{% endif %} product--add-to-cart-button"
                  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                  data-bottom-add-to-cart-swatch
                >
                  <i
                    class="fa fa-circle-o-notch fa-spin fa-fw bottom-loading-icon"
                    style="display: none;"
                  ></i>
                  <span class="sr-only">{{ 'collections.paginate.loading' | t }}</span>
                  <span
                    class="btn-text-ready"
                    style="display: {% if product.selected_or_first_available_variant.available %}inline{% else %}none{% endif %};"
                  >
                    {{- 'products.product.add_to_cart' | t -}}
                  </span>
                  <span 
                    class="btn-text-added" 
                    style="display: none;"
                  >
                    {{- 'products.product.added' | t -}}
                  </span>
                  <span
                    class="btn-text-soldout"
                    style="display: {% unless product.selected_or_first_available_variant.available %}inline{% else %}none{% endunless %};"
                  >
                    {{- 'products.product.sold_out' | t -}}
                  </span>
                  <span 
                    class="btn-text-unavailable" 
                    style="display: none;"
                  >
                    {{- 'products.product.unavailable' | t -}}
                  </span>
                </button>
    
                <noscript>
                  <button type="submit" class="btn" aria-label="{{ 'products.product.add_to_cart' | t }}">
                    <span>{{ 'products.product.add_to_cart' | t }}</span>
                  </button>
                </noscript>
    
                {% if buttons_block.settings.show_smart_checkout %}
                  {{ form | payment_button }}
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
      {% endif %} 

  </product-swatch>
{% endif %}
