<div class="product-card-basic">
  {% # Custom header %}

  {% # Product image %}
  {% if card_product.featured_media %}
    <div class="product-card-basic__image">
      <a href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
        <div class="{% unless settings.product-grid == 'natural' %}aspect-ratio aspect-ratio--{{ settings.product-grid }}{% endunless %}">
          {{ card_product.featured_media | image_url: width: 300 | image_tag: class: 'theme-img thumbnail-radius' }}
        </div>
      </a>
    </div>
  {% endif %}

  <div class="product-card-basic--info">
    <div class="product-card-basic--info--body">
      <div>
        {% # Vendor %}
        {% if show_vendor %}
          {% assign vendor_font = 'product-grid--vendor-font-' | append: settings.type_card_vendor_font %}
          <div class="product-card-basic__vendor {{ vendor_font }}">{{ card_product.vendor }}</div>
        {% endif %}

        {% # Product title %}
        {% assign title_font = 'product-grid--title-font-' | append: settings.type_card_title_font %}
        <div class="product-card-basic__title {{ title_font }}">
          <a href="{{ card_product.url }}">{{ card_product.title }}</a>
        </div>
      </div>

      {% # Price %}
      <div class="product-card-basic__price" data-product-price>
        {% render 'product-grid-item-price', price_product: card_product %}
      </div>
    </div>

    {% # Variant selector - Compact %}
    {% if card_product.variants.size > 1 %}
      <div class="product-card-basic__variant-selector">
        <select 
          id="variant-select-{{ card_product.id }}" 
          class="product-card-basic__variant-select"
          data-product-id="{{ card_product.id }}"
        >
          {% for variant in card_product.variants %}
            <option 
              value="{{ variant.id }}"
              data-image-src="{% if variant.featured_media %}{{ variant.featured_media | image_url: width: 300 }}{% else %}{{ card_product.featured_media | image_url: width: 300 }}{% endif %}"
              data-price="{{ variant.price }}"
              data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price }}{% endif %}"
              data-available="{{ variant.available }}"
              {% if variant == card_product.selected_or_first_available_variant %}selected{% endif %}
            >
              {{ variant.title }}{% unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
            </option>
          {% endfor %}
        </select>
      </div>
    {% endif %}

    <div class="product-card-basic--info--footer">
      <product-card-basic
        data-enable-quick-add="{{ enable_quick_add }}"
        data-cart-type="{{ settings.cart_type }}"
        data-cart-action="{{ settings.add_to_cart_action }}"
      >
        {% if card_product.available %}
          {%- liquid
            assign preorder_product = false
            assign preorder_string = 'products.product.preorder' | t | downcase

            for tag in card_product.tags
              assign lowercase_tag = tag | downcase
              if lowercase_tag contains preorder_string
                assign preorder_product = true
              endif
            endfor
          -%}
          {% form 'product', card_product, id: "ProductCardBasicAtcForm" %}
            <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}" />
            <input type="hidden" name="sections" value="cart-drawer" />
            <div class="product-card-basic__add-button{% if is_cart_drawer %} product-card-basic__add-button--cart-drawer{% endif %}">
              <button class="btn--underlined btn--underlined-with-icon{% if is_cart_drawer %} btn--cart-drawer{% endif %}" type="submit" {% unless card_product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                {% render 'theme-icon' with icon: 'shopping-bag', iconSize: 16, iconClasses: 'btn--underlined-with-icon__icon' %}
                <span>
                  {% if card_product.selected_or_first_available_variant.available %}
                    Buy Now
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                </span>
              </button>
            </div>
          {% endform %}
        {% else %}
          <div class="text-link-animated">
            <a class="btn--underlined-with-icon" href="{{ card_product.url }}" data-quick-view-link>
              {% render 'theme-icon' with icon: 'shopping-bag', iconSize: 14 %}
              <span>{{ 'products.product.sold_out' | t }}</span>
            </a>
          </div>
          <div
            data-add-to-cart-error
            class="product-card-basic__errors errors"
            aria-hidden="true"
            role="alert"
          ></div>
        {% endif %}
      </product-card-basic>
      <safe-load-scripts class="hidden">
        <script src="{{ 'component-product-card-basic.js' | asset_url }}" type="module" defer="defer" data-flow-load-key="component-product-card-basic"></script>
        <script src="{{ 'product-card-variant.js' | asset_url }}" defer="defer" data-flow-load-key="product-card-variant"></script>
      </safe-load-scripts>
    </div>
  </div>
</div>