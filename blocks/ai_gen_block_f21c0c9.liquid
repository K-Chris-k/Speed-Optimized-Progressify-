{% doc %}
    Customizable image
  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-image-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-responsive-image-desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-responsive-image-mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: auto;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-responsive-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: {{ block.settings.mobile_breakpoint }}px) {
    .ai-responsive-image-desktop-{{ ai_gen_id }} {
      {% if block.settings.mobile_image %}
        display: none;
      {% endif %}
    }

    .ai-responsive-image-mobile-{{ ai_gen_id }} {
      {% if block.settings.mobile_image %}
        display: block;
      {% endif %}
    }
  }
{% endstyle %}

<div
  class="ai-responsive-image-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
        srcset="{{ block.settings.desktop_image | image_url: width: 500 }} 500w,
                {{ block.settings.desktop_image | image_url: width: 1000 }} 1000w,
                {{ block.settings.desktop_image | image_url: width: 1500 }} 1500w,
                {{ block.settings.desktop_image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.desktop_image.width }}"
        height="{{ block.settings.desktop_image.height }}"
        class="ai-responsive-image-desktop-{{ ai_gen_id }}"
      >

      {% if block.settings.mobile_image %}
        <img
          src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
          srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                  {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                  {{ block.settings.mobile_image | image_url: width: 800 }} 800w,
                  {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w"
          sizes="100vw"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          class="ai-responsive-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    {% else %}
      <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
          Add a desktop image to get started
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const target = document.getElementById("judgeme_product_reviews");
  if (!target) return; // 目标不存在就退出，避免报错

  const DEFAULT_OFFSET = -100;
  const triggers = document.querySelectorAll('.ai-responsive-image-wrapper-{{ ai_gen_id }}');

  triggers.forEach(function(trigger){
    trigger.addEventListener("click", function (e) {
      e.preventDefault();
      const attr = trigger.getAttribute('data-offset');
      const offset = (attr !== null && attr !== undefined && attr !== '') ? parseInt(attr, 10) : DEFAULT_OFFSET;

      // 计算目标滚动位置（元素顶部相对于文档的 Y 坐标 + offset）
      const targetY = target.getBoundingClientRect().top + window.pageYOffset + offset;

      // 滚动但不修改 URL
      window.scrollTo({
        top: targetY,
        behavior: 'smooth'
      });
    });
  });
});
</script>



{% schema %}
{
  "name": "Responsive image",
  "settings": [
    {
      "type": "header",
      "content": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "header",
      "content": "Mobile image"
    },
    {
      "type": "paragraph",
      "content": "If no mobile image is provided, the desktop image will be used on mobile devices."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "mobile_breakpoint",
      "min": 480,
      "max": 1024,
      "step": 16,
      "unit": "px",
      "label": "Mobile breakpoint",
      "default": 768
    }
  ],
  "presets": [
    {
      "name": "Responsive image"
    }
  ]
}
{% endschema %}
