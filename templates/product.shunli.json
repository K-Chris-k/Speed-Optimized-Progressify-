    "advanced_layout_custom_liquid_qiphWB": {
      "type": "advanced-layout--custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<style>\n  .custom-testimonial-section {\n    padding: 80px 20px;\n    background-color: #F8F8F8;\n    font-family: ITC Franklin Gothic Bold;\n  }\n\n  .custom-testimonial-section h2 {\n    font-family: ITC Franklin Gothic Bold;\n    font-weight: 700;\n    font-size: 32px;\n    color: #2C2C2C;\n    text-align: center;\n    margin-bottom: 60px;\n  }\n\n  .testimonial-grid {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 30px;\n  }\n\n  .testimonial-card {\n    background: #fff;\n    border: 1px solid #A9A9A9;\n    border-radius: 12px;\n    padding: 30px;\n    width: 300px;\n    box-shadow: 0px 4px 8px rgba(0,0,0,0.08);\n    text-align: center;\n  }\n\n  .testimonial-img {\n    width: 60px;\n    height: 60px;\n    border-radius: 50%;\n    object-fit: cover;\n    margin-bottom: 10px;\n  }\n\n  .stars {\n    color: #C3B280;\n    margin-bottom: 10px;\n  }\n\n  .testimonial-text {\n    font-size: 16px;\n    color: #2C2C2C;\n    margin-bottom: 20px;\n  }\n\n  .testimonial-name {\n    font-weight: 700;\n    color: #C3B280;\n  }\n\n  .fade-in {\n    opacity: 0;\n    transform: translateY(20px);\n    transition: opacity 0.6s ease-out, transform 0.6s ease-out;\n  }\n\n  .fade-in.visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n</style>\n\n<div class=\"custom-testimonial-section\">\n  <h2>What Other Outdoorsmen Are Saying</h2>\n  <div class=\"testimonial-grid\">\n    <div class=\"testimonial-card fade-in\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0092/7173/8464/files/20231204_175218-5.jpg?v=1748032511\" class=\"testimonial-img\" alt=\"Customer 1\">\n      <div class=\"stars\">★★★★★</div>\n      <p class=\"testimonial-text\"><em>“So much lighter than any other product I’ve used… I’ve dropped this onto hard rocks multiple times while it was full and the bottle sustained zero damage.”</em></p>\n      <p class=\"testimonial-name\">— Christopher D. Chaput</p>\n    </div>\n    <div class=\"testimonial-card fade-in\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0092/7173/8464/files/Snapinsta.app_446195975_769853444968437_2642969448803393193_n_1080_66ce88fb-671b-4d6c-9d75-9b79b8cc53a2.jpg?v=1748032510\" class=\"testimonial-img\" alt=\"Customer 2\">\n      <div class=\"stars\">★★★★★</div>\n      <p class=\"testimonial-text\"><em>“The titanium is very durable and is perfect for my forest hiking adventures... SilverAnt is such a cool brand, I can’t wait to take this bottle out again!”</em></p>\n      <p class=\"testimonial-name\">— Ari</p>\n    </div>\n    <div class=\"testimonial-card fade-in\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0092/7173/8464/files/Woods_1_7d21b847-8f82-4b78-98d5-b6311405dc83.jpg?v=1748032512\" class=\"testimonial-img\" alt=\"Customer 3\">\n      <div class=\"stars\">★★★★★</div>\n      <p class=\"testimonial-text\"><em>“The bottle is amazingly light and durable… As long as I never lose it, I'll never need another water bottle again!”</em></p>\n      <p class=\"testimonial-name\">— Dallas Murphy</p>\n    </div>\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const faders = document.querySelectorAll(\".fade-in\");\n    const observer = new IntersectionObserver((entries, observer) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          entry.target.classList.add(\"visible\");\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.1 });\n    faders.forEach(el => observer.observe(el));\n  });\n</script>"
      }
    },
    "accordion_FCqkbM": {
      "type": "accordion",
      "blocks": {
        "tab_content_3XnwNp": {
          "type": "tab_content",
          "settings": {
            "question": "\"99.7% Titanium? Why not 100%?\"",
            "text": "<p>Because 99.7% is the <em>purest form of titanium</em> used in production — any purer, and it wouldn’t be usable. <br/><br/>You'll be holding the best there is.</p>"
          }
        },
        "tab_content_GTkhYA": {
          "type": "tab_content",
          "settings": {
            "question": "“Is this another China knockoff?”",
            "text": "<p>No. We <strong>own the factory</strong> (ISO 9001).<br/>Our <strong>products</strong> are <strong>FDA & SGS certified</strong>.<br/><strong>No white-label.</strong><br/><br/>We’ve been doing this for over two decades. <br/><br/>Others rebrand — we <em>build</em>.</p>"
          }
        },
        "tab_content_hF89R8": {
          "type": "tab_content",
          "settings": {
            "question": "“Is it really worth it?”",
            "text": "<p>That depends on if you want to keep spending money to replace gear that broke or will break. <br/><br/>This one replaces every water bottle you’ve ever bought — for life. <br/><br/>With a lifetime guarantee that backs that up.</p>"
          }
        },
        "tab_content_6kaitx": {
          "type": "tab_content",
          "settings": {
            "question": "\"Should I wait to buy?\"",
            "text": "<p>Only if you want to carry heavy, dented, leaking gear for one more trip.</p>"
          }
        }
      },
      "block_order": [
