        "image": "shopify://shop_images/10.png",
        "layout": "right",
        "title": "Why Buy From Us",
        "text": "<p>At SilverAnt, we combine <strong>expert craftsmanship, innovative design, and real-world testing</strong> to create titanium gear you can truly rely on. Made in our <strong>own factory</strong>, every product is carefully crafted to be lightweight, durable, and practical, shaped by the insights of our ambassadors who push our gear to its limits. When you buy from us, you’re not just getting equipment — you’re investing in quality, performance, and a brand committed to supporting your adventures for a lifetime.</p>",
        "text_alignment": "left",
        "text_overlapping_image": false,
        "button_link": "",
        "button_label": "",
        "buttons_style": "filled",
        "override_button_colors": false,
