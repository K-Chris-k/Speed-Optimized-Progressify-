      "settings": {
        "custom_liquid": "<!-- Mike Young Testimonial Section -->\n<div style=\"width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; background: #ffffff; padding: 0px 0;\">\n\n  <h2 style=\"font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; text-transform: uppercase; text-align: center; color: #2C2C2C; margin-bottom: 20px;\">\n    Hear What Mike Young Has to Say About SilverAnt Quality\n  </h2>\n\n  <div style=\"position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;\">\n    <!-- Thumbnail Image -->\n    <img\n      id=\"mikeThumbnail\"\n      src=\"https://cdn.shopify.com/s/files/1/0092/7173/8464/files/Your_paragraph_text.png?v=1749492583\"\n      alt=\"Mike Young Testimonial\"\n      style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; cursor: pointer; border-radius: 0; z-index: 2;\" />\n\n    <!-- Play Button Overlay -->\n    <div id=\"mikePlayButton\"\n      style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);\n             width: 70px; height: 70px; background: rgba(0,0,0,0.6); border-radius: 50%;\n             display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 3;\">\n      <svg viewBox=\"0 0 100 100\" width=\"36\" height=\"36\" fill=\"#fff\"><polygon points=\"40,30 70,50 40,70\" /></svg>\n    </div>\n\n    <!-- Shopify Video Embed -->\n    <video id=\"mikeVideo\" src=\"https://cdn.shopify.com/videos/c/o/v/29f12c59d6bd40109d6de5141b108c19.mp4\" playsinline controls\n      style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; display: none; z-index: 1;\">\n      Your browser does not support the video tag.\n    </video>\n  </div>\n</div>\n\n<!-- Video Toggle Script -->\n<script>\n  const mikeThumb = document.getElementById(\"mikeThumbnail\");\n  const mikePlay = document.getElementById(\"mikePlayButton\");\n  const mikeVideo = document.getElementById(\"mikeVideo\");\n\n  mikePlay.addEventListener(\"click\", () => {\n    mikeThumb.style.display = \"none\";\n    mikePlay.style.display = \"none\";\n    mikeVideo.style.display = \"block\";\n    mikeVideo.play();\n  });\n</script>"
      }
    },
    "advanced_layout_custom_liquid_ezfyXX": {
      "type": "advanced-layout--custom-liquid",
      "custom_css": [],
      "settings": {
        "custom_liquid": "<!-- Google Font Link (Oswald) -->\n<link href=\"https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .testimonial-block {\n    padding: 0px 20px;\n ;\n  }\n\n  .testimonial-block h2 {\n    font-family: 'Oswald', sans-serif;\n    font-size: 28px;\n    text-transform: uppercase;\n    text-align: center;\n    margin-bottom: 30px;\n  }\n\n  .testimonial {\n    display: flex;\n    align-items: stretch;\n    margin-bottom: 30px;\n  }\n\n  .testimonial-line {\n    width: 4px;\n    background: #00C2A0; /* Teal accent line */\n    margin-right: 15px;\n    border-radius: 2px;\n  }\n\n  .testimonial-content {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    background: white;\n    padding: 10px 15px;\n    border-radius: 6px;\n  }\n\n  .testimonial-content p {\n    font-size: 16px;\n    line-height: 1.6;\n    margin: 0 0 10px;\n    font-style: italic;\n  }\n\n  .testimonial-content strong {\n    font-style: normal;\n  }\n\n  .testimonial-name {\n    font-weight: bold;\n    margin: 0;\n  }\n\n  .stars {\n    color: #00C2A0;\n    margin-bottom: 5px;\n    font-size: 18px;\n  }\n</style>\n\n<div class=\"testimonial-block\">\n  <h2>What Other Solo Adventurers, hikers, & campers Are Saying</h2>\n\n  <!-- Testimonial 1 -->\n  <div class=\"testimonial\">\n    <div class=\"testimonial-line\"></div>\n    <div class=\"testimonial-content\">\n      <div class=\"stars\">★★★★★</div>\n      <p>“<strong>So much lighter</strong> than any other product I’ve used… I’ve <strong>dropped this onto hard rocks</strong> multiple times while it was full and the bottle <strong>sustained zero damage</strong>.”</p>\n      <p class=\"testimonial-name\">— Christopher D. Chaput</p>\n    </div>\n  </div>\n\n  <!-- Testimonial 2 -->\n  <div class=\"testimonial\">\n    <div class=\"testimonial-line\"></div>\n    <div class=\"testimonial-content\">\n      <div class=\"stars\">★★★★★</div>\n      <p>“The <strong>titanium is very durable</strong> and is perfect for my <strong>forest hiking adventures</strong>... SilverAnt is such a <strong>cool brand</strong>, I can’t wait to take this bottle out again!”</p>\n      <p class=\"testimonial-name\">— Ari</p>\n    </div>\n  </div>\n\n  <!-- Testimonial 3 -->\n  <div class=\"testimonial\">\n    <div class=\"testimonial-line\"></div>\n    <div class=\"testimonial-content\">\n      <div class=\"stars\">★★★★★</div>\n      <p>“The bottle is <strong>amazingly light and durable</strong>… As long as I never lose it, I'll <strong>never need another water bottle again</strong>!”</p>\n      <p class=\"testimonial-name\">— Dallas Murphy</p>\n    </div>\n  </div>\n</div>"
      }
    },
    "advanced_layout_custom_liquid_rnnhAR": {
      "type": "advanced-layout--custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<!-- Fonts -->\n<link href=\"https://fonts.googleapis.com/css2?family=Open+Sans&family=Oswald&display=swap\" rel=\"stylesheet\">\n\n<!-- Trust Stats -->\n<div style=\"display: flex; justify-content: space-around; flex-wrap: wrap; gap: 20px; margin: 0 auto; max-width: 1000px; font-family: 'Open Sans', sans-serif;\">\n\n  <!-- Customers -->\n  <div style=\"flex: 1 1 200px; text-align: center;\">\n    <svg width=\"40\" height=\"40\" fill=\"#00C2A0\" viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 \n    14.14L18.18 21.02L12 17.77L5.82 \n    21.02L7 14.14L2 9.27L8.91 \n    8.26L12 2Z\"/></svg>\n    <div class=\"countup\" data-count=\"17000\" style=\"font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; margin: 8px 0; color: #000;\">0+</div>\n    <div style=\"font-size: 14px; font-weight: 700; color: #333;\">Happy Customers</div>\n  </div>\n\n  <!-- Certified Titanium -->\n  <div style=\"flex: 1 1 200px; text-align: center;\">\n    <svg width=\"40\" height=\"40\" fill=\"#00C2A0\" viewBox=\"0 0 24 24\"><path d=\"M12 2L1 9l11 13L23 9 12 \n    2z\"/></svg>\n    <div style=\"font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; margin: 8px 0; color: #000;\">99.7%</div>\n    <div style=\"font-size: 14px; font-weight: 700; color: #333;\">World's Highest Grade Titanium</div>\n  </div>\n\n  <!-- Years of Craft -->\n  <div style=\"flex: 1 1 200px; text-align: center;\">\n    <svg width=\"40\" height=\"40\" fill=\"#00C2A0\" viewBox=\"0 0 24 24\"><path d=\"M12 2a10 10 0 1 0 0 \n    20 10 10 0 0 0 0-20zm1 3v5h4v2h-6V7h2z\"/></svg>\n    <div class=\"countup\" data-count=\"23\" style=\"font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; margin: 8px 0; color: #000;\">0+</div>\n    <div style=\"font-size: 14px; font-weight: 700; color: #333;\">Years of Craftsmanship</div>\n  </div>\n\n  <!-- Factory -->\n  <div style=\"flex: 1 1 200px; text-align: center;\">\n    <svg width=\"40\" height=\"40\" fill=\"#00C2A0\" viewBox=\"0 0 24 24\"><path d=\"M2 22h20v-2H2v2zm2-4h16V9l-5 \n    3.5V9l-5 3.5V9l-6 4V18z\"/></svg>\n    <div style=\"font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; margin: 8px 0; color: #000;\">ISO:9001</div>\n    <div style=\"font-size: 14px; font-weight: 700; color: #333;\">Family-Owned ISO Certified Factory</div>\n  </div>\n\n</div>\n\n<!-- Count-Up Script -->\n<script>\n  const counters = document.querySelectorAll(\".countup\");\n  counters.forEach(counter => {\n    const target = parseFloat(counter.getAttribute(\"data-count\"));\n    let count = 0;\n    const step = () => {\n      let increment = target / 100;\n      count += increment;\n      if (count < target) {\n        counter.innerText = Math.floor(count) + \"+\";\n        requestAnimationFrame(step);\n      } else {\n        counter.innerText = Math.floor(target) + \"+\";\n      }\n    };\n    step();\n  });\n</script>"
      }
    },
