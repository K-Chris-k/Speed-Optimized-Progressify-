    "advanced_layout_custom_liquid_ktFU8L": {
      "type": "advanced-layout--custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<!-- FAQ SECTION -->\n<style>\n  .faq-container {\n    max-width: 800px;\n    margin: 0px auto;\n    font-family: 'Open Sans', sans-serif;\n  }\n\n  .faq-title {\n    font-family: 'Oswald', sans-serif;\n    font-size: 28px;\n    text-align: center;\n    font-weight: 700;\n    margin-bottom: 30px;\n  }\n\n  .faq-item {\n    border-top: 1px solid #ccc;\n  }\n\n  .faq-question {\n    font-weight: 700;\n    font-size: 18px;\n    padding: 16px;\n    cursor: pointer;\n    position: relative;\n    background-color: #f9f9f9;\n    transition: background 0.3s;\n  }\n\n  .faq-question:hover {\n    background-color: #f1f1f1;\n  }\n\n  .faq-question::after {\n    content: \"+\";\n    position: absolute;\n    right: 20px;\n    font-size: 24px;\n    transition: transform 0.3s ease;\n  }\n\n  .faq-item.open .faq-question::after {\n    content: \"−\";\n  }\n\n  .faq-answer {\n    display: none;\n    padding: 0 16px 16px;\n    font-size: 16px;\n    line-height: 1.6;\n  }\n\n  .faq-item.open .faq-answer {\n    display: block;\n  }\n</style>\n\n<div class=\"faq-container\">\n  <h2 class=\"faq-title\">What You May Be Thinking</h2>\n\n  <div class=\"faq-item open\">\n    <div class=\"faq-question\">“Why not 100% titanium?”</div>\n    <div class=\"faq-answer\">\n      Because 99.7% is the purest form of titanium used in production — any purer, and it wouldn’t be usable. You will have the best there is.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">“Is this another China knockoff?”</div>\n    <div class=\"faq-answer\">\n      No. We own the factory. FDA Certified. ISO:9001 Approved. No white-label. We’ve been doing this for over two decades. Others rebrand — we build.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">“Is the price really worth it?”</div>\n    <div class=\"faq-answer\">\n      You’re not just buying a bottle. You’re buying the last one you’ll ever need—because this one is built to survive. That price? It pays for itself every year it keeps showing up.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">“Should I wait?”</div>\n    <div class=\"faq-answer\">\n      Only if you want to carry heavy, dented, leaking gear for one more trip.\n    </div>\n  </div>\n</div>\n\n<script>\n  document.querySelectorAll('.faq-question').forEach(q => {\n    q.addEventListener('click', () => {\n      const item = q.parentElement;\n      item.classList.toggle('open');\n    });\n  });\n</script>"
      }
    },
