;\n  }\n\n  proofLink.addEventListener(\"click\", function (e) {\n    e.preventDefault();\n    document.getElementById(\"proof-video\").scrollIntoView({ behavior: \"smooth\" });\n    setTimeout(playHeroVideo, 600);\n  });\n\n  thumb.addEventListener(\"click\", playHeroVideo);\n  playBtn.addEventListener(\"click\", playHeroVideo);\n</script>"
