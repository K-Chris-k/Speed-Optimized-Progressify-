        "richtext_db6DqU": {
          "type": "richtext",
          "settings": {
            "text": "<p>Our gear is tested and developed with the assistance of our ambassadors, who are motivated by the desire to make our equipment lighter, more compact, and more durable. This drive is reflected in the titanium gear that we produce.</p>",
            "text_size": 16,
            "text_bottom_spacing": 20
          }
        }
      },
